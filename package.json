{
  "name": "app",
  "private": true,
  "engines": {
    "node": "26.13.1",
    "yarn": "1.22.22"
  },
  "scripts": {
    "build:css:compile": "postcss ./app/assets/stylesheets/application.postcss.css -o ./app/assets/builds/application.css",
    "build:css:fonts": "mkdir -p app/assets/builds/fonts && cp node_modules/bootstrap-icons/font/fonts/* app/assets/builds/fonts/",
    "build:css": "yarn build:css:fonts && yarn build:css:compile",
    "build": "esbuild app/javascript/application.js engines/cfp_website/app/javascript/cfp_website.js --bundle --format=esm --outdir=app/assets/builds --entry-names=[name] --public-path=/assets"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@popperjs/core": "^2.11.8",
    "@rails/actioncable": "^8.1.401",
    "autoprefixer": "^10.7.0",
    "bootstrap": "^5.3.9",
    "bootstrap-icons": "^1.13.2",
    "chart.js": "^4.6.2",
    "chartkick": "^5.0.1",
    "datatables.net-bs5": "^3",
    "highlight.js": "^11.12.0",
    "postcss": "^8.5.34",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.1",
    "postcss-nesting": "^14.0.3",
    "tom-select": "^2.7.0",
    "tributejs": "^5.1.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "browserslist": [
    "defaults"
  ]
}
