# Secrets are fetched at deploy time from AWS Parameter Store (/cfp-app/*) in
# ap-northeast-1. Requires AWS credentials (OIDC role on GHA, `aws sso login`
# etc. locally). Each line is self-contained so it does not depend on kamal
# carrying intermediate variables between secret definitions.

KAMAL_REGISTRY_PASSWORD=$(aws ecr get-login-password --region ap-northeast-1)

DATABASE_URL=$(aws ssm get-parameter --name /cfp-app/DATABASE_URL --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
SECRET_KEY_BASE=$(aws ssm get-parameter --name /cfp-app/SECRET_KEY_BASE --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
GITHUB_KEY=$(aws ssm get-parameter --name /cfp-app/GITHUB_KEY --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
GITHUB_SECRET=$(aws ssm get-parameter --name /cfp-app/GITHUB_SECRET --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
TWITTER_KEY=$(aws ssm get-parameter --name /cfp-app/TWITTER_KEY --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
TWITTER_SECRET=$(aws ssm get-parameter --name /cfp-app/TWITTER_SECRET --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
SMTP_ADDRESS=$(aws ssm get-parameter --name /cfp-app/SMTP_ADDRESS --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
SMTP_DOMAIN=$(aws ssm get-parameter --name /cfp-app/SMTP_DOMAIN --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
SMTP_USERNAME=$(aws ssm get-parameter --name /cfp-app/SMTP_USERNAME --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
SMTP_PASSWORD=$(aws ssm get-parameter --name /cfp-app/SMTP_PASSWORD --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
SENTRY_DSN=$(aws ssm get-parameter --name /cfp-app/SENTRY_DSN --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
SLACK_WEBHOOK_URL=$(aws ssm get-parameter --name /cfp-app/SLACK_WEBHOOK_URL --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
CLOUDFRONT_ORIGIN_SECRET=$(aws ssm get-parameter --name /cfp-app/CLOUDFRONT_ORIGIN_SECRET --with-decryption --region ap-northeast-1 --query Parameter.Value --output text)
