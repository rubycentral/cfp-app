= render 'shared/event_info_bar', event: event

%div.mt-4{data: {controller: 'proposals-table'}}
  .row
    .col-sm-8.text-start
      %ul.selection-counts
        %li
          %a{data: {action: 'click->proposals-table#filterByStatus', status_filter: 'accepted'}, role: 'button'} Accepted (Not Confirmed)
          %span.badge.text-bg-warning= @accepted_not_confirmed_count
        %li
          %a{data: {action: 'click->proposals-table#filterByStatus', status_filter: 'accepted_confirmed'}, role: 'button'} Accepted (Confirmed)
          %span.badge.text-bg-success= @accepted_confirmed_count
    .col-sm-4.text-end
      %small.text-end <em>Hint:</em> Hold <kbd>shift</kbd> to sort by multiple columns

  .row
    .col-md-12
      - column_types = ['number', 'number', 'number', 'text', 'text', *([nil] if tracks_enabled?), 'text', *(['text'] if event.public_tags?), 'text', 'select', nil]
      %table.datatable.table.table-striped.proposal-list{data: {proposals_table_target: 'table', cfp_column_types: column_types.to_json}}
        %thead
          %tr
            %th
            %th
            %th
            %th
            %th
            - if tracks_enabled?
              %th
            %th
            - if event.public_tags?
              %th
            %th
            %th
            %th.actions
          %tr
            %th Score
            %th Ratings
            %th Standard Deviation
            %th Speakers
            %th Talk Title
            - if tracks_enabled?
              %th Track
            %th Session Format
            - if event.public_tags?
              %th Proposal Tags
            %th Reviewer Tags
            %th Status
            %th.actions Soft Actions (Internal)
        %tbody
          = render @proposals
