= turbo_frame_tag 'grid-modal-content' do
  .modal-dialog
    .modal-content
      .modal-header
        .col-6
          %h3
            = session.title
      .modal-body
        .selected-session-info
          - {'Format': 'session_format_name',
              **({'Track': 'track_name'} if tracks_enabled?).to_h,
              'Presenter':'speaker_names',
              'Abstract': 'abstract',
              'Suggested Duration': 'suggested_duration',
            }.each do |attr, getter_method|
            - value = session.public_send(getter_method)
            - if value != "" && value != nil
              .session-meta-item
                %strong= "#{attr}:"
                %p=value
      .modal-footer
        %button.btn.btn-secondary{type: 'button', 'data-bs-dismiss' => 'modal'} Close
